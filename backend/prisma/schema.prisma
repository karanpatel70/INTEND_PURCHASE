generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  registrar
  hod
  indenter
  acc_top
  acc_mid
  acc_low
  pur_top
  pur_mid
  pur_low
}

enum UserStatus {
  pending
  active
  blocked
}

model User {
  id                  Int                 @id @default(autoincrement())
  name                String
  email               String              @unique
  passwordHash        String?
  role                Role                @default(indenter)
  designation         String?
  departmentId        Int?
  department          ListItem?           @relation(fields: [departmentId], references: [id])
  status              UserStatus          @default(pending)
  createdAt           DateTime            @default(now())
  created             Indent[]            @relation("Creator")
  holding             Indent[]            @relation("Holder")
  historyActions      IndentHistory[]     @relation("HistoryActor")
  createdLimits       FormLimit[]         @relation("FormLimitCreator")
  approvalAuthorities ApprovalAuthority[]
  uploadedAttachments Attachment[]        @relation("AttachmentUploader")
  requestedExtensions PoExtension[]       @relation("ExtensionRequester")
  decidedExtensions   PoExtension[]       @relation("ExtensionDecider")
  reminders           Reminder[]
  auditLogs           AuditLog[]
}

model ListItem {
  id    Int    @id @default(autoincrement())
  list  String
  value String
  users User[]

  @@unique([list, value])
}

model FormTemplate {
  id           Int      @id @default(autoincrement())
  code         String
  version      Int      @default(1)
  name         String
  workflowCode String
  limit        Json?
  sections     Json
  active       Boolean  @default(true)
  indents      Indent[]

  @@unique([code, version])
}

model WorkflowTemplate {
  id      Int      @id @default(autoincrement())
  code    String
  version Int      @default(1)
  steps   Json
  indents Indent[]

  @@unique([code, version])
}

model FormLimit {
  id            Int      @id @default(autoincrement())
  formCode      String
  rule          String
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  reason        String?
  createdById   Int
  createdBy     User     @relation("FormLimitCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([formCode, rule, effectiveFrom], map: "FormLimit_lookup")
}

model Indent {
  id             Int              @id @default(autoincrement())
  number         String           @unique
  formTemplateId Int
  formTemplate   FormTemplate     @relation(fields: [formTemplateId], references: [id])
  workflowId     Int
  workflow       WorkflowTemplate @relation(fields: [workflowId], references: [id])
  createdById    Int
  createdBy      User             @relation("Creator", fields: [createdById], references: [id])
  holderId       Int?
  holder         User?            @relation("Holder", fields: [holderId], references: [id], onDelete: Restrict)
  stage          String
  data           Json
  total          Decimal          @db.Decimal(12, 2)
  limitApplied   Decimal          @db.Decimal(12, 2)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  history        IndentHistory[]
  order          PurchaseOrder?
  attachments    Attachment[]
  reminders      Reminder[]

  @@index([holderId], map: "Indent_holder")
  @@index([createdById], map: "Indent_creator")
}

model IndentHistory {
  id        Int      @id @default(autoincrement())
  indentId  Int
  indent    Indent   @relation(fields: [indentId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     User     @relation("HistoryActor", fields: [actorId], references: [id])
  action    String
  fromStage String
  toStage   String
  remark    String?
  at        DateTime @default(now())

  @@index([indentId], map: "IndentHistory_indent")
}

model PurchaseOrder {
  id         Int           @id @default(autoincrement())
  indentId   Int           @unique
  indent     Indent        @relation(fields: [indentId], references: [id], onDelete: Cascade)
  poNumber   String        @unique
  vendor     String
  orderDate  DateTime
  dueDate    DateTime
  status     String        @default("ongoing")
  data       Json?
  extensions PoExtension[]
  reminders  Reminder[]
}

model ApprovalAuthority {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  formCode  String
  maxAmount Decimal @db.Decimal(12, 2)
  active    Boolean @default(true)

  @@unique([userId, formCode])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  indentId     Int
  indent       Indent   @relation(fields: [indentId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  sizeBytes    Int?
  uploadedById Int
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([indentId], map: "Attachment_indent")
}

model PoExtension {
  id            Int           @id @default(autoincrement())
  orderId       Int
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldDueDate    DateTime
  newDueDate    DateTime
  reason        String
  status        String        @default("pending")
  requestedById Int
  requestedBy   User          @relation("ExtensionRequester", fields: [requestedById], references: [id])
  decidedById   Int?
  decidedBy     User?         @relation("ExtensionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
}

model Reminder {
  id       Int            @id @default(autoincrement())
  userId   Int
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  indentId Int?
  indent   Indent?        @relation(fields: [indentId], references: [id], onDelete: Cascade)
  orderId  Int?
  order    PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind     String
  sendAt   DateTime
  sentAt   DateTime?

  @@index([sendAt], map: "Reminder_due")
}

model AuditLog {
  id      Int      @id @default(autoincrement())
  actorId Int?
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action  String
  target  String?
  detail  Json?
  at      DateTime @default(now())
}
